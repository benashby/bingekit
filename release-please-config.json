{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "tag-separator": "/",
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore: release${component} ${version}",
  "pull-request-header": "Merging this releases the version below and publishes it.",
  "pull-request-footer": "The changelog comes from the Conventional Commit messages since the last release.",
  "packages": {
    "episode": {
      "release-type": "rust",
      "component": "episode",
      "package-name": "bingekit-episode",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "/mpv-launcher/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='bingekit-episode')].version"
        }
      ]
    },
    "library": {
      "release-type": "rust",
      "component": "library",
      "package-name": "bingekit-library",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "/mpv-launcher/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='bingekit-library')].version"
        }
      ]
    },
    "mpv-launcher": {
      "release-type": "rust",
      "component": "mpv-launcher",
      "package-name": "mpv-launcher",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
